{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-sanitized.mjs node_modules/vitest/vitest.mjs run",
    "pretest": "node scripts/run-sanitized.mjs scripts/build-backend.mjs",
    "test:completion": "node scripts/run-sanitized.mjs node_modules/vitest/vitest.mjs run backend/trainingCompletion.test.js",
    "pretest:completion": "node scripts/run-sanitized.mjs scripts/build-backend.mjs",
    "test:completion:emulator": "node scripts/run-completion-emulator.mjs",
    "pretest:completion:emulator": "node scripts/run-sanitized.mjs scripts/build-backend.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "server": "node server.js",
    "predeploy": "npm run build && copy CNAME dist\\CNAME && copy ads.txt dist\\ads.txt",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "openai": "^6.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "sass": "^1.94.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.6",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "homepage": "https://edulience.space/"
}
