{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": "dist-backend",
    "types": ["node"]
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-backend", "backend/**/*.test.ts"]
}
